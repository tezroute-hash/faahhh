<% layout("layouts/boilerplate") -%>

    <div class="list-container">

        <h2>Following</h2>

        <% if (following.length===0) { %>

            <p>Not following anyone yet.</p>

            <% } else { %>

                <% following.forEach(followedUser=> { %>

                    <a href="/profile/<%= followedUser._id %>" class="user-list-item">

                        <% if (followedUser.profilePic) { %>

                            <img src="<%= followedUser.profilePic %>" alt="Profile" class="user-avatar-img">

                            <% } else { %>

                                <div class="user-avatar-placeholder">
                                    <%= followedUser.username.charAt(0).toUpperCase() %>
                                </div>

                                <% } %>


                                    <div class="user-list-info">

                                        <strong>
                                            <%= followedUser.username %>
                                        </strong>

                                        <span class="user-list-name">
                                            <%= followedUser.name %>
                                        </span>

                                    </div>

                    </a>

                    <% }) %>

                        <% } %>

    </div>