<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= typeof title !=='undefined' ? title : 'Faahhh Platform' %>
    </title>
    <link rel="stylesheet" href="/css/style.css">
    <!-- Unicons for icons -->
    <link rel="stylesheet" href="https://unicons.iconscout.com/release/v4.0.0/css/line.css">
</head>

<body>
    <nav class="navbar">
        <a href="<%= typeof user !== 'undefined' && user ? '/faahhh' : '/login' %>" class="brand">
            <i class="uil uil-fire"></i> Faahhh<span>App</span>
        </a>
        <div class="navbar-nav">
            <% if (typeof user !=='undefined' && user) { %>
                <a href="/faahhh"><i class="uil uil-dashboard"></i> Dashboard</a>
                <a href="/profile/<%= user._id || user.id %>"><i class="uil uil-user"></i> Profile</a>
                <% } else { %>
                    <a href="/login"><i class="uil uil-signin"></i> Login</a>
                    <a href="/signup"><i class="uil uil-user-plus"></i> Sign Up</a>
                    <% } %>
        </div>
    </nav>
    <div class="container <%= typeof centered !== 'undefined' && centered ? 'centered-layout' : '' %>">