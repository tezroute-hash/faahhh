<aside class="sidebar">

    <!-- LOGO -->
    <a href="/hangout" class="sidebar-logo">
        Hangout
    </a>


    <!-- MAIN NAVIGATION -->
    <div class="nav-links">

        <!-- HOME -->
        <a href="/hangout" class="nav-link">
            <i class="uil uil-estate"></i>
            <span>Home</span>
        </a>


        <!-- SEARCH -->
        <a href="/search" class="nav-link">
            <i class="uil uil-search"></i>
            <span>Search</span>
        </a>


        <% if (currentUser) { %>

            <!-- MESSAGES -->
            <a href="/messages" class="nav-link">
                <i class="uil uil-message"></i>
                <span>Messages</span>
            </a>


            <!-- CREATE -->
            <a href="/create" class="nav-link">
                <i class="uil uil-plus-circle"></i>
                <span>Create</span>
            </a>


            <!-- MY PROFILE -->
            <a
                href="/profile/<%= currentUser._id %>"
                class="nav-link"
            >
                <i class="uil uil-user-circle"></i>
                <span>Profile</span>
            </a>


        <% } else { %>

            <!-- LOGIN -->
            <a href="/login" class="nav-link">
                <i class="uil uil-signin"></i>
                <span>Login</span>
            </a>

        <% } %>

    </div>


    <!-- SPACER -->
    <div style="flex-grow: 1;"></div>


    <!-- BOTTOM NAVIGATION -->
    <div class="nav-links">

        <% if (currentUser) { %>

            <!-- LOGOUT -->
            <a
                href="/user/logout"
                class="nav-link"
            >
                <i class="uil uil-signout"></i>
                <span>Log out</span>
            </a>

        <% } %>

    </div>

</aside>