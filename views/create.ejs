<% layout("layouts/boilerplate") -%>

    <div class="create-container">

        <!-- Header -->
        <h2 class="create-title">
            Create Post
        </h2>

        <!-- Tabs -->
        <div class="create-tabs-container">
            <button type="button" class="type-tab active" data-type="text">
                📝 Text
            </button>
            <button type="button" class="type-tab" data-type="photo">
                🖼️ Photo
            </button>
            <button type="button" class="type-tab" data-type="video">
                🎥 Video
            </button>
        </div>

        <!-- MAIN FORM -->
        <form action="/post/user/<%= user._id %>/posts" method="POST" enctype="multipart/form-data">

            <!-- MEDIA STUDIO AREA -->
            <div id="mediaStudio" class="media-studio" style="display: none;">

                <div id="uploadPrompt" class="upload-prompt">
                    <i id="uploadIcon" class="uil uil-image-plus upload-icon"></i>
                    <div id="uploadText" class="upload-text">Select a Photo</div>
                    <div class="upload-hint">Click or drag and drop</div>
                </div>

                <!-- Preview Wrapper (for dynamic background blur) -->
                <div id="previewContainer" class="preview-wrapper" style="display: none;">
                    <div id="blurBg" class="blur-bg"></div>
                    <img id="imagePreview" src="" class="preview-img" style="display: none;">
                    <video id="videoPreview" src="" class="preview-video" style="display: none;" controls muted></video>

                    <div id="changeOverlay" class="change-overlay">
                        Change Media
                    </div>
                </div>

                <input type="file" id="imageInput" name="image" style="display: none;">
            </div>

            <!-- CANVAS / CAPTION -->
            <div style="position: relative;">
                <textarea id="contentText" name="content" placeholder="What's on your mind?" maxlength="2200"
                    class="content-textarea"></textarea>

                <!-- Quick Emojis -->
                <div id="quickEmojis" class="quick-emojis">
                    <span class="emoji-btn">✨</span>
                    <span class="emoji-btn">🔥</span>
                    <span class="emoji-btn">❤️</span>
                    <span class="emoji-btn">😂</span>
                    <span class="emoji-btn">🙌</span>
                    <span class="emoji-btn">🎉</span>
                    <span class="emoji-btn">🚀</span>
                    <span class="emoji-btn">💯</span>
                    <span class="emoji-btn">👀</span>
                    <span class="emoji-btn">💡</span>
                    <span class="emoji-btn">🌟</span>
                    <span class="emoji-btn">🤔</span>
                </div>

                <div class="char-count-row">
                    <span id="charCount">0/2200</span>
                </div>
            </div>

            <button type="submit" class="publish-btn">
                Publish Post
            </button>
        </form>
    </div>

    <script>
        const tabs = document.querySelectorAll('.type-tab');
        const mediaStudio = document.getElementById('mediaStudio');
        const contentText = document.getElementById('contentText');
        const imageInput = document.getElementById('imageInput');

        const uploadPrompt = document.getElementById('uploadPrompt');
        const uploadIcon = document.getElementById('uploadIcon');
        const uploadText = document.getElementById('uploadText');
        const previewContainer = document.getElementById('previewContainer');
        const blurBg = document.getElementById('blurBg');
        const imagePreview = document.getElementById('imagePreview');
        const videoPreview = document.getElementById('videoPreview');

        let currentType = 'text';

        tabs.forEach(tab => {
            tab.addEventListener('click', () => {
                tabs.forEach(t => t.classList.remove('active'));
                tab.classList.add('active');

                const type = tab.getAttribute('data-type');
                currentType = type;

                if (type === 'text') {
                    mediaStudio.style.display = 'none';
                    imageInput.value = ''; // clear any media
                    // Canvas mode
                    contentText.style.fontSize = '22px';
                    contentText.style.minHeight = '250px';
                    contentText.placeholder = "What's on your mind?";
                    resetPreview();
                }
                else if (type === 'photo') {
                    mediaStudio.style.display = 'block';
                    imageInput.accept = 'image/*';
                    uploadIcon.className = 'uil uil-image-plus upload-icon';
                    uploadText.textContent = 'Select a Photo';
                    // Caption mode
                    contentText.style.fontSize = '15px';
                    contentText.style.minHeight = '120px';
                    contentText.placeholder = "Write a caption...";

                    // Clear state if previously video
                    if (videoPreview.src && videoPreview.style.display === 'block') {
                        imageInput.value = '';
                        resetPreview();
                    }
                }
                else if (type === 'video') {
                    mediaStudio.style.display = 'block';
                    imageInput.accept = 'video/*';
                    uploadIcon.className = 'uil uil-video upload-icon';
                    uploadText.textContent = 'Select a Video';
                    // Caption mode
                    contentText.style.fontSize = '15px';
                    contentText.style.minHeight = '120px';
                    contentText.placeholder = "Write a caption...";

                    // Clear state if previously photo
                    if (imagePreview.src && imagePreview.style.display === 'block') {
                        imageInput.value = '';
                        resetPreview();
                    }
                }
            });
        });

        mediaStudio.addEventListener('click', () => {
            imageInput.click();
        });

        function resetPreview() {
            previewContainer.style.display = 'none';
            uploadPrompt.style.display = 'flex';
            imagePreview.style.display = 'none';
            videoPreview.style.display = 'none';
            blurBg.style.backgroundImage = 'none';
            mediaStudio.style.borderStyle = 'dashed';
        }

        imageInput.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (!file) return resetPreview();

            const objUrl = URL.createObjectURL(file);

            uploadPrompt.style.display = 'none';
            previewContainer.style.display = 'flex';
            mediaStudio.style.borderStyle = 'solid';
            mediaStudio.style.borderColor = '#e2e8f0';

            if (file.type.startsWith('video/')) {
                videoPreview.src = objUrl;
                videoPreview.style.display = 'block';
                imagePreview.style.display = 'none';
                blurBg.style.backgroundImage = 'none';
            } else {
                imagePreview.src = objUrl;
                imagePreview.style.display = 'block';
                videoPreview.style.display = 'none';
                blurBg.style.backgroundImage = `url(${objUrl})`;
            }
        });

        // Emojis
        document.querySelectorAll('.emoji-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                contentText.value += btn.textContent;
                contentText.focus();
                updateCount();
            });
        });

        // Char count
        const charCount = document.getElementById('charCount');
        function updateCount() {
            charCount.textContent = `${contentText.value.length}/2200`;
        }
        contentText.addEventListener('input', updateCount);

    </script>