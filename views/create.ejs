<% layout("layouts/boilerplate") -%>
    <div
        style="max-width: 540px; margin: 0 auto; background: white; border-radius: var(--border-radius-lg); box-shadow: var(--shadow-md); padding: 40px 30px;">
        <h2
            style="font-family: 'Outfit', sans-serif; font-size: 2rem; font-weight: 800; text-align: center; margin-bottom: 30px; color: var(--text-dark);">
            Create & Feed
        </h2>

        <form action="/post" method="POST" enctype="multipart/form-data" class="auth-form" style="gap: 20px;">
            <!-- Media Upload Area mimicking Cloudinary Storage -->
            <div
                style="width: 100%; height: 260px; border: 2px dashed #cbd5e1; border-radius: var(--border-radius-md); display: flex; flex-direction: column; justify-content: center; align-items: center; color: var(--text-light); cursor: pointer; background: #f8fafc; transition: all 0.2s ease;">
                <i class="uil uil-cloud-upload"
                    style="font-size: 3.5rem; margin-bottom: 10px; color: var(--primary);"></i>
                <span style="font-weight: 500; font-size: 15px; color: var(--text-dark);">Drag photos and videos
                    here</span>
                <span style="font-size: 13px; margin-top: 8px;">Images will be mapped to Cloudinary URLs</span>
                <input type="file" name="media" accept="image/*,video/*" style="display: none;">
                <button type="button" class="btn-follow" style="margin-top: 20px; font-weight: 600;">Select from
                    computer</button>
            </div>

            <textarea name="caption" rows="4" placeholder="Write a gorgeous caption..."
                style="width: 100%; padding: 20px; border: 1px solid #f1f5f9; border-radius: var(--border-radius-sm); font-size: 15px; outline: none; resize: none; background: #f8fafc; font-family: 'Inter', sans-serif;"></textarea>

            <div style="display: flex; justify-content: space-between; align-items: center; padding: 0 5px;">
                <i class="uil uil-smile" style="font-size: 1.5rem; color: var(--text-light); cursor: pointer;"></i>
                <span style="font-size: 13px; color: var(--text-light);">0/2200</span>
            </div>

            <button type="submit"
                style="margin-top: 5px; padding: 18px; border-radius: var(--border-radius-md); font-size: 16px; font-weight: 700;">Share
                to Feed</button>
        </form>
    </div>
    <style>
        div[style*="border: 2px dashed"]:hover {
            background: #f1f5f9 !important;
            border-color: var(--primary) !important;
        }
    </style>