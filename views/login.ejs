<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login &bull; Hangout</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <div class="auth-wrapper">
        <div class="auth-container">
            <div class="auth-box">
                <h1 class="logo">Hangout</h1>
                <% if (typeof error !=='undefined' && error) { %>
                    <div class="error-msg">
                        <%= error %>
                    </div>
                    <% } %>
                        <form action="/user/login" method="post" class="auth-form">
                            <input type="email" name="email" placeholder="Enter email" required>
                            <input type="password" name="password" placeholder="Enter password" required>
                            <p style="text-align: right; margin-bottom: 20px;"><a href="/user/forgot-password"
                                    style="font-size: 13px; color: var(--primary);">Forgot Password?</a></p>
                            <button type="submit">Log in</button>

                            <div style="display: flex; align-items: center; margin: 15px 0;">
                                <div class="divider-row"></div>
                            </div>
                        </form>
            </div>

            <div class="auth-box alt">
                <span class="auth-msg-alt">Don't have an account? <a href="/signup">Sign up</a></span>
            </div>
        </div>
    </div>
</body>

</html>