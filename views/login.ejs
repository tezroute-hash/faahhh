<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login &bull; Instagram</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <div class="auth-wrapper">
        <div class="auth-container">
            <div class="auth-box">
                <h1 class="logo">Faahhh</h1>
                <form action="/user/login" method="post" class="auth-form">
                    <input type="email" name="email" placeholder="Phone number, username, or email" required>
                    <input type="password" name="password" placeholder="Password" required>
                    <button type="submit">Log in</button>

                    <div style="display: flex; align-items: center; margin: 15px 0;">
                        <div style="flex: 1; height: 1px; background: var(--border-color);"></div>
                        <div
                            style="margin: 0 16px; color: var(--text-light); font-weight: 600; font-size: 12px; text-transform: uppercase;">
                            or</div>
                        <div style="flex: 1; height: 1px; background: var(--border-color);"></div>
                    </div>
                </form>

                <div style="text-align: center; margin-top: 15px;">
                    <a href="#" style="color: #385185; font-weight: 600; font-size: 14px;">Log in with Facebook</a>
                </div>
                <div style="text-align: center; margin-top: 15px;">
                    <a href="#" style="color: #00376b; font-size: 12px;">Forgot password?</a>
                </div>
            </div>

            <div class="auth-box alt">
                <span" style="font-size: 14px;">Don't have an account? <a href="/signup"
                        style="color: var(--blue-primary); font-weight: 600;">Sign up</a></span>
            </div>

            <div style="text-align: center; font-size: 14px; margin-top: 10px;">
                <p>Get the app.</p>
                <div style="margin-top: 10px; display: flex; justify-content: center; gap: 10px;">
                    <div
                        style="width: 130px; height: 40px; background: #000; border-radius: 4px; display: flex; align-items: center; justify-content: center; color: white;">
                        App Store</div>
                    <div
                        style="width: 130px; height: 40px; background: #000; border-radius: 4px; display: flex; align-items: center; justify-content: center; color: white;">
                        Google Play</div>
                </div>
            </div>
        </div>
    </div>
</body>

</html>