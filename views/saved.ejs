<% layout("layouts/boilerplate") -%>

<div class="saved-page">

    <!-- ========================= -->
    <!-- PAGE HEADER -->
    <!-- ========================= -->

    <div class="saved-page-header">

        <div>
            <h1>
                <i class="uil uil-bookmark"></i>
                Saved Posts
            </h1>

            <p>
                Posts you've saved for later
            </p>
        </div>

    </div>


    <!-- ========================= -->
    <!-- NO SAVED POSTS -->
    <!-- ========================= -->

    <% if (!savedPosts || savedPosts.length === 0) { %>

        <div class="saved-empty">

            <div class="saved-empty-icon">
                <i class="uil uil-bookmark"></i>
            </div>

            <h2>
                No saved posts
            </h2>

            <p>
                Posts you bookmark will appear here.
            </p>

            <a
                href="/hangout"
                class="saved-browse-btn"
            >
                Browse Posts
            </a>

        </div>


    <% } else { %>


        <!-- ========================= -->
        <!-- SAVED POSTS -->
        <!-- ========================= -->

        <div class="saved-posts-list">

            <% savedPosts.forEach(post => { %>

                <% if (post) { %>

                    <article class="saved-post-card">


                        <!-- ========================= -->
                        <!-- POST HEADER -->
                        <!-- ========================= -->

                        <div class="saved-post-header">

                            <div class="saved-user">


                                <!-- PROFILE IMAGE -->
                                <% if (post.author && post.author.profilePic) { %>

                                    <a
                                        href="/profile/<%= post.author._id %>"
                                    >

                                        <img
                                            src="<%= post.author.profilePic %>"
                                            class="saved-user-img"
                                            alt="<%= post.author.username %>"
                                        >

                                    </a>

                                <% } else { %>


                                    <!-- DEFAULT AVATAR -->
                                    <a
                                        href="<%= post.author ? '/profile/' + post.author._id : '#' %>"
                                        class="saved-user-placeholder"
                                    >

                                        <%= post.author && post.author.username
                                            ? post.author.username.charAt(0).toUpperCase()
                                            : "U"
                                        %>

                                    </a>

                                <% } %>


                                <!-- USER INFO -->
                                <div class="saved-user-info">

                                    <% if (post.author) { %>

                                        <a
                                            href="/profile/<%= post.author._id %>"
                                            class="saved-user-name"
                                        >

                                            <%= post.author.name || post.author.username %>

                                        </a>

                                        <span class="saved-user-handle">

                                            @<%= post.author.username %>

                                        </span>

                                    <% } else { %>

                                        <span class="saved-user-name">
                                            Unknown User
                                        </span>

                                    <% } %>

                                </div>

                            </div>


                            <!-- VIEW POST -->
                            <a
                                href="/profile/<%= post._id %>/view"
                                class="saved-view-btn"
                            >
                                View Post
                            </a>

                        </div>


                        <!-- ========================= -->
                        <!-- IMAGE POST -->
                        <!-- ========================= -->

                        <% if (post.type === "image" && post.mediaUrl) { %>

                            <a
                                href="/profile/<%= post._id %>/view"
                                class="saved-image-container"
                            >

                                <img
                                    src="<%= post.mediaUrl %>"
                                    alt="Saved post"
                                >

                            </a>

                        <% } %>


                        <!-- ========================= -->
                        <!-- TEXT / CAPTION -->
                        <!-- ========================= -->

                        <% if (post.content) { %>

                            <a
                                href="/profile/<%= post._id %>/view"
                                class="saved-content"
                            >

                                <%= post.content %>

                            </a>

                        <% } %>


                        <!-- ========================= -->
                        <!-- FOOTER -->
                        <!-- ========================= -->

                        <div class="saved-post-footer">

                            <span
                            style="
                                color: var(--text-light);
                                text-transform: uppercase;
                                font-size: 10px;
                                margin-top: 6px;
                                display: block;
                            "
                        >

                        <%= new Date().toLocaleString("en-IN", {
                                timeZone: "Asia/Kolkata",
                                day: "2-digit",
                                month: "2-digit",
                                year: "numeric",
                                hour: "2-digit",
                                minute: "2-digit",
                                second: "2-digit",
                                hour12: true
                            }) %>

                        </span>

                            <!-- REMOVE -->
                            <form
                                action="/hangout/<%= post._id %>/unsave"
                                method="POST"
                            >

                                <button
                                    type="submit"
                                    class="unsave-btn"
                                    title="Remove from Saved"
                                >

                                    <i class="uil uil-bookmark"></i>

                                    Remove

                                </button>

                            </form>

                        </div>


                    </article>

                <% } %>

            <% }) %>

        </div>

    <% } %>

</div>