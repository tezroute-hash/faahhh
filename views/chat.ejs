<% layout("layouts/boilerplate") -%>

    <!-- =========================
     CHAT CONTAINER
========================= -->

    <div class="chat-modal-container">


        <!-- =========================
         CHAT HEADER
    ========================= -->

        <div class="chat-modal-header">


            <!-- PROFILE IMAGE -->

            <div class="chat-modal-avatar">

                <% if (receiver.profilePic) { %>

                    <img src="<%= receiver.profilePic %>" alt="Profile">

                    <% } else { %>

                        <%= receiver.username.charAt(0).toUpperCase() %>

                            <% } %>

            </div>


            <!-- USER INFO -->

            <div>

                <div class="chat-modal-username">
                    <%= receiver.username %>
                </div>

                <div class="chat-modal-status">
                    Message
                </div>

            </div>

        </div>



        <!-- =========================
         MESSAGES
    ========================= -->

        <div class="chat-modal-messages">


            <% if (messages.length===0) { %>


                <!-- EMPTY CHAT -->

                <div class="chat-modal-empty">

                    Start a conversation with
                    <strong style="margin-left: 5px;">
                        @<%= receiver.username %>
                    </strong>

                </div>


                <% } else { %>


                    <!-- MESSAGE LIST -->

                    <% messages.forEach(message=> { %>


                        <% const isSent=message.sender._id.toString()===currentUser._id.toString(); %>


                            <!-- MESSAGE ROW -->

                            <div class="<%= isSent
                        ? 'chat-modal-row chat-modal-sent'
                        : 'chat-modal-row chat-modal-received' %>">


                                <!-- MESSAGE BUBBLE -->

                                <div class="<%= isSent
                            ? 'chat-modal-bubble sent'
                            : 'chat-modal-bubble received' %>">


                                    <!-- MESSAGE TEXT -->

                                    <%= message.text %>


                                        <!-- MESSAGE TIME -->

                                        <div class="chat-modal-time">

                                            <%= new Date( message.createdAt ).toLocaleTimeString([], { hour: "2-digit" ,
                                                minute: "2-digit" }) %>

                                        </div>


                                </div>

                            </div>


                            <% }) %>


                                <% } %>


        </div>



        <!-- =========================
         MESSAGE INPUT
    ========================= -->

        <form action="/messages/<%= receiver._id %>" method="POST" class="chat-modal-form">


            <input type="text" name="text" placeholder="Write a message..." required autocomplete="off"
                class="chat-modal-input">


            <button type="submit" class="chat-modal-send" title="Send">

                <i class="uil uil-message"></i>

            </button>


        </form>


    </div>