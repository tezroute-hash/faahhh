<% layout("layouts/boilerplate") -%>

<% if (typeof user !== "undefined" && user) { %>

    <!-- PROFILE HEADER -->
    <div class="profile-header">

        <% if (user.profilePic && user.profilePic !== "") { %>

            <img
                src="<%= user.profilePic %>"
                alt="Profile"
                class="avatar-lg"
                style="object-fit: cover; border: none; padding: 0;"
            >

        <% } else { %>

            <div class="avatar-lg">
                <%= user.username
                    ? user.username.charAt(0).toUpperCase()
                    : "U"
                %>
            </div>

        <% } %>


        <div class="profile-details">

            <div class="profile-name-row">

                <h2 class="profile-username">
                    <%= user.username %>
                </h2>

                <% if (
                    currentUser &&
                    currentUser._id.toString() === user._id.toString()
                ) { %>

                    <a
                        href="/profile/<%= user._id %>/edit"
                        class="btn-outline"
                    >
                        Edit profile
                    </a>

                <% } %>

            </div>


            <!-- PROFILE STATS -->
            <div class="profile-stats">

                <span>
                    <strong><%= posts.length %></strong>
                    posts
                </span>

                <a
                    href="/profile/<%= user._id %>/followers"
                    style="text-decoration: none; color: inherit;"
                >
                    <span>
                        <strong><%= user.followers.length %></strong>
                        followers
                    </span>
                </a>

                <a
                    href="/profile/<%= user._id %>/following"
                    style="text-decoration: none; color: inherit;"
                >
                    <span>
                        <strong><%= user.following.length %></strong>
                        following
                    </span>
                </a>

            </div>


            <div class="profile-name">
                <%= user.name || user.username %>
            </div>


            <div class="profile-bio">

                <%= user.email %>

                <% if (user.bio) { %>
                    <br>
                    <b><%= user.bio %></b>
                <% } %>

            </div>

        </div>

    </div>


    <!-- TABS -->
    <div class="profile-tabs">

        <div class="profile-tab active">
            <i class="uil uil-grid"></i>
            ALL POSTS
        </div>

    </div>


    <!-- POSTS GRID -->

    <% if (posts && posts.length > 0) { %>

        <div
            style="
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 4px;
                margin-top: 10px;
            "
        >

            <% posts.forEach(post => { %>

                <% if (post.type === "image" && post.mediaUrl) { %>

                    <div
                        style="
                            aspect-ratio: 1;
                            overflow: hidden;
                            background: #efefef;
                            cursor: pointer;
                        "
                    >

                        <img
                            src="<%= post.mediaUrl %>"
                            alt="Post"
                            style="
                                width: 100%;
                                height: 100%;
                                object-fit: cover;
                                display: block;
                            "
                        >

                    </div>

                <% } else if (post.type === "video" && post.mediaUrl) { %>

                    <div
                        style="
                            aspect-ratio: 1;
                            overflow: hidden;
                            background: #000;
                            cursor: pointer;
                        "
                    >

                        <video
                            src="<%= post.mediaUrl %>"
                            style="
                                width: 100%;
                                height: 100%;
                                object-fit: cover;
                            "
                            controls
                        ></video>

                    </div>

                <% } else { %>

                    <!-- TEXT POST -->

                    <div
                        style="
                            aspect-ratio: 1;
                            background: #f3f3f3;
                            display: flex;
                            justify-content: center;
                            align-items: center;
                            padding: 20px;
                            text-align: center;
                            cursor: pointer;
                        "
                    >

                        <p>
                            <%= post.content %>
                        </p>

                    </div>

                <% } %>

            <% }) %>

        </div>

    <% } else { %>

        <!-- NO POSTS -->

        <div
            style="
                text-align: center;
                padding: 60px 20px;
                color: var(--text-light);
            "
        >

            <i
                class="uil uil-camera"
                style="font-size: 50px;"
            ></i>

            <h2>No posts yet</h2>

            <% if (
                currentUser &&
                currentUser._id.toString() === user._id.toString()
            ) { %>

                <p>Create your first post.</p>

                <a href="/create" class="btn-outline">
                    Create Post
                </a>

            <% } %>

        </div>

    <% } %>

<% } else { %>

    <!-- USER NOT FOUND -->

    <div
        style="
            text-align: center;
            padding: 40px;
        "
    >

        <h2>User Not Found</h2>

        <p>
            Sorry, this page isn't available.
        </p>

        <p>
            The link you followed may be broken,
            or the page may have been removed.
        </p>

    </div>

<% } %>