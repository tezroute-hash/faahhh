<% layout("layouts/boilerplate") -%>

<div style="max-width: 600px; margin: 30px auto;">

    <h2>Followers</h2>

    <% if (followers.length === 0) { %>

        <p>No followers yet.</p>

    <% } else { %>

        <% followers.forEach(follower => { %>

            <a
                href="/profile/<%= follower._id %>"
                style="
                    display: flex;
                    align-items: center;
                    gap: 15px;
                    padding: 15px;
                    text-decoration: none;
                    color: inherit;
                    border-bottom: 1px solid #ddd;
                "
            >

                <% if (follower.profilePic) { %>

                    <img
                        src="<%= follower.profilePic %>"
                        alt="Profile"
                        style="
                            width: 50px;
                            height: 50px;
                            border-radius: 50%;
                            object-fit: cover;
                        "
                    >

                <% } else { %>

                    <div
                        style="
                            width: 50px;
                            height: 50px;
                            border-radius: 50%;
                            background: #ddd;
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            font-size: 20px;
                            font-weight: bold;
                        "
                    >
                        <%= follower.username.charAt(0).toUpperCase() %>
                    </div>

                <% } %>


                <div>

                    <strong>
                        <%= follower.username %>
                    </strong>

                    <br>

                    <span style="color: #777;">
                        <%= follower.name %>
                    </span>

                </div>

            </a>

        <% }) %>

    <% } %>

</div>