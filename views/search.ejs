<% layout("layouts/boilerplate") -%>

<h2>Search Users</h2>

<form action="/search" method="get">
    <input
        type="text"
        name="username"
        placeholder="Search username"
        required
    >

    <button type="submit">Search</button>
</form>

<% if (searched) { %>

    <h3>Search Results</h3>

    <% if (users.length === 0) { %>

        <p>No users found.</p>

    <% } else { %>

        <% users.forEach(user => { %>

            <div>
                <a href="/profile/<%= user._id %>">
                    @<%= user.username %>
                </a>
            </div>

        <% }) %>

    <% } %>

<% } %>