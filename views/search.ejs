<% layout("layouts/boilerplate") -%>

    <div class="search-container">
        <form action="/search" method="get">
            <input type="text" name="username" placeholder="Search" required>
            <button type="submit" style="display: none;">Search</button>
        </form>
    </div>

    <% if (typeof searched !=='undefined' && searched) { %>
        <h3 class="search-recent-title">Recent</h3>

        <div class="search-results-list">
            <% if (users.length===0) { %>
                <p class="search-no-results">No results found.</p>
                <% } else { %>
                    <% users.forEach(user=> { %>
                        <div class="user-item">
                            <div class="avatar-med">
                                <%= user.username.charAt(0).toUpperCase() %>
                            </div>
                            <div class="user-info-row">
                                <a href="/profile/<%= user._id %>">
                                    <strong>
                                        <%= user.username %>
                                    </strong>
                                    <span>
                                        <%= user.name || 'Instagram User' %>
                                    </span>
                                </a>
                            </div>
                            <a href="/profile/<%= user._id %>" class="search-view-btn">View</a>
                        </div>
                        <% }) %>
                            <% } %>
        </div>
        <% } %>