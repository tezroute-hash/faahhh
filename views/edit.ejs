<% layout("layouts/boilerplate") -%>

    <div class="auth-wrapper edit-wrapper">
        <div class="auth-container">
            <div class="auth-box">
                <h2 class="edit-title">Edit Profile</h2>

                <form action="/user/profile/<%= user._id %>/edit" method="post" enctype="multipart/form-data"
                    class="auth-form">

                    <div style="margin-bottom: 20px;">
                        <label class="input-label">Profile Picture</label>
                        <div class="file-upload-box">
                            <input type="file" name="profileImage" accept="image/*" class="file-upload-input">
                            <div class="file-hint">(JPEG, PNG uploaded to Cloudinary)</div>
                        </div>
                    </div>

                    <div style="margin-bottom: 15px;">
                        <label class="input-label">Name</label>
                        <input type="text" value="<%= user.name %>" name="name" placeholder="Name" required>
                    </div>

                    <div style="margin-bottom: 15px;">
                        <label class="input-label">Username</label>
                        <input type="text" value="<%= user.username %>" name="username" placeholder="Username" required>
                    </div>

                    <div style="margin-bottom: 15px;">
                        <label class="input-label">Email</label>
                        <input type="text" value="<%= user.email %>" name="email" placeholder="Email" required>
                    </div>

                    <div style="margin-bottom: 15px;">
                        <label class="input-label">Bio</label>
                        <input type="text" value="<%= user.bio %>" name="bio" placeholder="Bio">
                    </div>

                    <button type="submit" style="margin-top: 20px;">Save Changes</button>
                </form>
            </div>
        </div>
    </div>