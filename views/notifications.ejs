<% layout("layouts/boilerplate") -%>
    <div class="notif-container">
        <h2 class="notif-title">
            User Alerts
        </h2>

        <div class="notif-list">
            <% if (notifications && notifications.length> 0) { %>
                <% function timeAgo(date) { const s=Math.floor((new Date() - date) / 1000); if (s < 60)
                    return "just now" ; const m=Math.floor(s / 60); if (m===1) return "1 minute ago" ; if (m < 60)
                    return m + " minutes ago" ; const h=Math.floor(s / 3600); if (h===1) return "1 hour ago" ; if (h <
                    24) return h + " hours ago" ; const d=Math.floor(s / 86400); if (d===1) return "1 day ago" ; if (d <
                    30) return d + " days ago" ; const mo=Math.floor(s / 2592000); if (mo===1) return "1 month ago" ; if
                    (mo < 12) return mo + " months ago" ; const y=Math.floor(s / 31536000); if (y===1)
                    return "1 year ago" ; return y + " years ago" ; } %>
                    <% notifications.forEach(function(notification) { %>
                        <% if (notification.type==='like' ) { %>
                            <div class="notif-row">
                                <div class="notif-avatar"
                                    style="<%= notification.sender.profilePic ? 'background-image: url(' + notification.sender.profilePic + ');' : '' %>">
                                    <%= !notification.sender.profilePic ?
                                        notification.sender.name.charAt(0).toUpperCase() : '' %>
                                </div>
                                <div class="notif-text">
                                    <strong class="notif-author">
                                        <%= notification.sender.name %>
                                    </strong> loved your recent post.
                                    <span class="notif-time">
                                        <%= timeAgo(notification.createdAt) %>
                                    </span>
                                </div>
                                <% if (notification.post) { %>
                                    <a href="/profile/<%= notification.post._id %>/view">
                                        <% if (notification.post.mediaUrl) { %>
                                            <div class="notif-post-media"
                                                style="background-image: url('<%= notification.post.mediaUrl %>');">
                                            </div>
                                            <% } else { %>
                                                <div class="notif-post-placeholder">
                                                    Text
                                                </div>
                                                <% } %>
                                    </a>
                                    <% } else { %>
                                        <div class="notif-post-placeholder">
                                            Deleted
                                        </div>
                                        <% } %>
                            </div>
                            <% } else if (notification.type==='follow' ) { %>
                                <div class="notif-row">
                                    <div class="notif-avatar"
                                        style="<%= notification.sender.profilePic ? 'background-image: url(' + notification.sender.profilePic + ');' : '' %>">
                                        <%= !notification.sender.profilePic ?
                                            notification.sender.name.charAt(0).toUpperCase() : '' %>
                                    </div>
                                    <div class="notif-text">
                                        <strong class="notif-author">
                                            <%= notification.sender.name %>
                                        </strong> started following you.
                                        <span class="notif-time">
                                            <%= timeAgo(notification.createdAt) %>
                                        </span>
                                    </div>
                                    <a href="/profile/<%= notification.sender._id %>" style="text-decoration: none;">
                                        <button class="btn-follow">Profile</button>
                                    </a>
                                </div>
                                <% } else if (notification.type==='comment' ) { %>
                                    <div class="notif-row">
                                        <div class="notif-avatar"
                                            style="<%= notification.sender.profilePic ? 'background-image: url(' + notification.sender.profilePic + ');' : '' %>">
                                            <%= !notification.sender.profilePic ?
                                                notification.sender.name.charAt(0).toUpperCase() : '' %>
                                        </div>
                                        <div class="notif-text">
                                            <strong class="notif-author">
                                                <%= notification.sender.name %>
                                            </strong> commented on your post.
                                            <span class="notif-time">
                                                <%= timeAgo(notification.createdAt) %>
                                            </span>
                                        </div>
                                        <% if (notification.post) { %>
                                            <a href="/profile/<%= notification.post._id %>/view">
                                                <% if (notification.post.mediaUrl) { %>
                                                    <div class="notif-post-media"
                                                        style="background-image: url('<%= notification.post.mediaUrl %>');">
                                                    </div>
                                                    <% } else { %>
                                                        <div class="notif-post-placeholder">
                                                            Text
                                                        </div>
                                                        <% } %>
                                            </a>
                                            <% } else { %>
                                                <div class="notif-post-placeholder">
                                                    Deleted
                                                </div>
                                                <% } %>
                                    </div>
                                    <% } %>
                                        <% }); %>
                                            <% } else { %>
                                                <div class="notif-empty">
                                                    No notifications yet.
                                                </div>
                                                <% } %>
        </div>
    </div>