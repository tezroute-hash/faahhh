<% layout("layouts/boilerplate") -%>
    <div
        style="max-width: 600px; margin: 0 auto; background: white; border-radius: var(--border-radius-lg); box-shadow: var(--shadow-md); padding: 35px 30px;">
        <h2
            style="font-family: 'Outfit', sans-serif; font-size: 1.8rem; font-weight: 800; margin-bottom: 25px; border-bottom: 1px solid #f1f5f9; padding-bottom: 20px; color: var(--text-dark);">
            User Alerts
        </h2>

        <div style="display: flex; flex-direction: column; gap: 24px;">
            <!-- Notification Item: Like -->
            <div style="display: flex; align-items: center; gap: 16px;">
                <div class="avatar-med" style="width: 50px; height: 50px; font-size: 1.2rem;">R</div>
                <div style="flex: 1; font-size: 15px; line-height: 1.4;">
                    <strong style="color: var(--text-dark); font-weight: 700;">Rachel</strong> loved your recent post.
                    <span style="display: block; color: var(--text-light); font-size: 13px; margin-top: 4px;">1 hour
                        ago</span>
                </div>
                <div
                    style="width: 48px; height: 48px; background: var(--bg-color-main) url('https://via.placeholder.com/48') center / cover; border-radius: 8px;">
                </div>
            </div>

            <!-- Notification Item: Follow System -->
            <div style="display: flex; align-items: center; gap: 16px;">
                <div class="avatar-med" style="width: 50px; height: 50px; font-size: 1.2rem;">D</div>
                <div style="flex: 1; font-size: 15px; line-height: 1.4;">
                    <strong style="color: var(--text-dark); font-weight: 700;">Daniel</strong> started following you.
                    <span style="display: block; color: var(--text-light); font-size: 13px; margin-top: 4px;">4 hours
                        ago</span>
                </div>
                <button class="btn-follow">Follow Back</button>
            </div>

            <!-- Notification Item: Comment -->
            <div style="display: flex; align-items: center; gap: 16px;">
                <div class="avatar-med" style="width: 50px; height: 50px; font-size: 1.2rem;">E</div>
                <div style="flex: 1; font-size: 15px; line-height: 1.4;">
                    <strong style="color: var(--text-dark); font-weight: 700;">Eleanor</strong> commented: "This plan
                    looks incredible!"
                    <span
                        style="display: block; color: var(--text-light); font-size: 13px; margin-top: 4px;">Yesterday</span>
                </div>
                <div
                    style="width: 48px; height: 48px; background: var(--bg-color-main) url('https://via.placeholder.com/48') center / cover; border-radius: 8px;">
                </div>
            </div>
        </div>
    </div>