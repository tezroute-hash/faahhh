<% layout("layouts/boilerplate") -%>

    <div class="auth-wrapper">
        <div class="auth-container">

            <div class="auth-box">

                <div class="auth-logo">Hangout</div>

                <h2 style="text-align: center; margin-bottom: 20px;">Create New Password</h2>

                <p style="text-align: center; color: var(--text-light); margin-bottom: 25px; font-size: 14px;">
                    Your email has been verified! Type a new, secure password below.
                </p>

                <% if (typeof error !=='undefined' && error) { %>
                    <div class="error-msg">
                        <%= error %>
                    </div>
                    <% } %>

                        <form action="/user/reset-password" method="POST" class="auth-form">

                            <input type="hidden" name="email" value="<%= email %>">

                            <input type="password" name="password" placeholder="New Password" required minlength="6">

                            <button type="submit">Reset Password</button>
                        </form>

            </div>

        </div>
    </div>