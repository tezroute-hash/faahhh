<% layout("layouts/boilerplate") -%>

    <div class="view-container">


        <!-- =====================================
         POST
    ====================================== -->

        <div class="post-card">


            <!-- =================================
             POST HEADER
        ================================== -->

            <div class="post-header">


                <!-- PROFILE IMAGE -->

                <% if (post.author && post.author.profilePic) { %>

                    <a href="/profile/<%= post.author._id %>">

                        <img src="<%= post.author.profilePic %>" class="avatar" alt="Profile">

                    </a>

                    <% } else { %>

                        <div class="avatar-placeholder">

                            <%= post.author && post.author.name ? post.author.name.charAt(0).toUpperCase() : "U" %>

                        </div>

                        <% } %>


                            <!-- =================================
                 AUTHOR INFORMATION
            ================================== -->

                            <div class="author-info">


                                <!-- NAME -->

                                <div class="author-name">

                                    <a href="/profile/<%= post.author._id %>">

                                        <%= post.author && post.author.name ? post.author.name : "Unknown User" %>

                                    </a>

                                </div>


                                <!-- USERNAME -->

                                <div class="username">

                                    @<%= post.author && post.author.username ? post.author.username : "user" %>

                                </div>


                            </div>


                            <!-- =================================
                 DELETE BUTTON
            ================================== -->

                            <% if ( currentUser && post.author &&
                                post.author._id.toString()===currentUser._id.toString() ) { %>


                                <form action="/profile/<%= user._id %>/view/delete/<%= post._id %>?_method=DELETE"
                                    method="POST" class="delete-form">


                                    <button type="submit" class="delete-btn"
                                        onclick="return confirm('Are you sure you want to delete this post?')">

                                        Delete

                                    </button>


                                </form>


                                <% } %>


            </div>


            <!-- =================================
             POST CONTENT
        ================================== -->

            <% if (post.content) { %>

                <div class="post-content">

                    <%= post.content %>

                </div>

                <% } %>


                    <!-- =================================
             IMAGE
        ================================== -->

                    <% if (post.type==="image" && post.mediaUrl) { %>

                        <img src="<%= post.mediaUrl %>" class="post-media" alt="Post">

                        <% } %>


                            <!-- =================================
             VIDEO
        ================================== -->

                            <% if (post.type==="video" && post.mediaUrl) { %>

                                <video src="<%= post.mediaUrl %>" class="post-media" controls></video>

                                <% } %>


                                    <!-- =================================
             POST DATE
        ================================== -->

                                    <div class="post-date">

                                        <%= new Date(post.createdAt).toLocaleString() %>

                                    </div>


                                    <!-- =================================
             POST ACTIONS
        ================================== -->

                                    <div class="post-actions">


                                        <% if (currentUser) { %>
                                            <form action="/profile/<%= post._id %>/view/like" method="POST"
                                                style="display:inline;">
                                                <button type="submit" class="action-btn">
                                                    <%= userLiked ? '❤️' : '🤍' %>
                                                        <%= likeCount %> Likes
                                                </button>
                                            </form>
                                            <% } else { %>
                                                <button class="action-btn" disabled>
                                                    ❤️ <%= likeCount %> Likes
                                                </button>
                                                <% } %>



                                                    <span>

                                                        💬 <%= comments.length %> Comments

                                                    </span>


                                    </div>


        </div>


        <!-- =====================================
         COMMENTS CARD
    ====================================== -->

        <div class="comments-card">


            <h2 class="comments-title">

                Comments (<%= comments.length %>)

            </h2>


            <!-- =================================
             ADD COMMENT
        ================================== -->

            <% if (currentUser) { %>


                <form action="/profile/<%= post._id %>/comment" method="POST" class="comment-form">


                    <textarea name="text" placeholder="Write a comment..." maxlength="500" required></textarea>


                    <button type="submit" class="comment-btn">

                        Comment

                    </button>


                </form>


                <% } else { %>


                    <p>

                        <a href="/login">Login</a> to comment.

                    </p>


                    <% } %>


                        <!-- =================================
             COMMENT LIST
        ================================== -->

                        <% if (comments.length===0) { %>


                            <div class="empty-comments">

                                No comments yet.

                                <br>

                                Be the first to comment.

                            </div>


                            <% } else { %>


                                <% comments.forEach(comment=> { %>


                                    <div class="comment">


                                        <!-- =========================
                         COMMENT AUTHOR IMAGE
                    ========================== -->

                                        <% if (comment.author && comment.author.profilePic) { %>


                                            <img src="<%= comment.author.profilePic %>" class="avatar" alt="Profile">


                                            <% } else { %>


                                                <div class="avatar-placeholder">

                                                    <%= comment.author && comment.author.name ?
                                                        comment.author.name.charAt(0).toUpperCase() : "U" %>

                                                </div>


                                                <% } %>


                                                    <!-- =========================
                         COMMENT CONTENT
                    ========================== -->

                                                    <div>


                                                        <!-- COMMENT NAME -->

                                                        <strong>

                                                            <%= comment.author && comment.author.name ?
                                                                comment.author.name : "Unknown User" %>

                                                        </strong>


                                                        <!-- COMMENT USERNAME -->

                                                        <div class="username">

                                                            @<%= comment.author && comment.author.username ?
                                                                comment.author.username : "user" %>

                                                        </div>


                                                        <!-- COMMENT TEXT -->

                                                        <p class="comment-text">

                                                            <%= comment.text %>

                                                        </p>


                                                        <!-- COMMENT DATE -->

                                                        <div class="comment-date">

                                                            <%= new Date(comment.createdAt).toLocaleString() %>

                                                        </div>


                                                    </div>


                                    </div>


                                    <% }) %>


                                        <% } %>


        </div>


    </div>