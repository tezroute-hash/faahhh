<%- include('./partials/header', { title: 'Sign Up | Faahhh' , centered: true }) %>

    <div class="glass-card">
        <h1>Create <span>Account</span></h1>
        <p style="text-align: center; color: var(--text-muted); margin-bottom: 2rem;">Join us and get started in
            seconds.</p>

        <form action="/user" method="post">
            <div class="form-group">
                <label for="name"><i class="uil uil-user"></i> Full Name</label>
                <input type="text" id="name" name="name" placeholder="John Doe" required>
            </div>

            <div class="form-group">
                <label for="username"><i class="uil uil-at"></i> Username</label>
                <input type="text" id="username" name="username" placeholder="johndoe123" required>
            </div>

            <div class="form-group">
                <label for="email"><i class="uil uil-envelope-alt"></i> Email Address</label>
                <input type="email" id="email" name="email" placeholder="john@doe.com" required>
            </div>

            <div class="form-group">
                <label for="password"><i class="uil uil-lock-alt"></i> Password</label>
                <input type="password" id="password" name="password" placeholder="Create a strong password" required>
            </div>

            <button type="submit" class="btn"><i class="uil uil-user-plus"></i> Create Account</button>

            <div class="auth-footer">
                Already have an account? <a href="/login">Login here</a>
            </div>
        </form>
    </div>

    <%- include('./partials/footer') %>