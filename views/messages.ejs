<% layout("layouts/boilerplate") -%>

    <div class="messages-container <%= typeof receiver !== 'undefined' && receiver ? 'chat-active' : '' %>">

        <!-- ==================== LEFT SIDE ==================== -->
        <div class="messages-sidebar">

            <!-- TITLE -->
            <div class="messages-title">
                Messages
            </div>

            <!-- CONVERSATIONS -->
            <div class="conversations-list">

                <% if (conversations && conversations.length> 0) { %>

                    <% conversations.forEach(conversation=> { %>

                        <a href="/messages/<%= conversation.user._id %>" class="conversation-item
                        <% if (
                            receiver &&
                            receiver._id.toString() ===
                            conversation.user._id.toString()
                        ) { %>
                            active-conversation
                        <% } %>">

                            <!-- PROFILE IMAGE -->
                            <div class="convo-avatar avatar-med">

                                <% if (conversation.user.profilePic) { %>

                                    <img src="<%= conversation.user.profilePic %>" alt="Profile" class="convo-img">

                                    <% } else { %>

                                        <%= conversation.user.username .charAt(0) .toUpperCase() %>

                                            <% } %>

                            </div>


                            <!-- USER INFO -->
                            <div class="convo-info">

                                <strong>
                                    <%= conversation.user.username %>
                                </strong>


                                <div class="convo-text">
                                    <%= conversation.lastMessage.text %>
                                </div>

                            </div>


                            <!-- DATE -->
                            <div class="convo-date">
                                <%= new Date( conversation.lastMessage.createdAt ).toLocaleDateString() %>
                            </div>

                        </a>

                        <% }) %>


                            <% } else { %>

                                <!-- NO CONVERSATIONS -->

                                <div class="no-conversations">

                                    <i class="uil uil-message no-convos-icon"></i>

                                    <h3>
                                        No messages yet
                                    </h3>

                                    <p>
                                        Visit someone's profile to start a conversation.
                                    </p>

                                </div>

                                <% } %>

            </div>

        </div>



        <!-- ==================== RIGHT SIDE ==================== -->

        <div class="chat-container">

            <% if (receiver) { %>

                <!-- ==================== CHAT HEADER ==================== -->

                <div class="chat-header">
                    <!-- Mobile Back Button -->
                    <a href="/messages" class="mobile-back-btn"
                        style="display: none; font-size: 24px; color: var(--text-dark); margin-right: 10px; text-decoration: none;">
                        <i class="uil uil-angle-left"></i>
                    </a>

                    <!-- PROFILE IMAGE -->

                    <div class="chat-avatar avatar-med">

                        <% if (receiver.profilePic) { %>

                            <img src="<%= receiver.profilePic %>" alt="Profile" class="convo-img">

                            <% } else { %>

                                <%= receiver.username .charAt(0) .toUpperCase() %>

                                    <% } %>

                    </div>


                    <!-- USER NAME -->

                    <div>
                        <strong class="chat-username">
                            <%= receiver.username %>
                        </strong>

                        <div class="chat-fullname">
                            <%= receiver.name || receiver.username %>
                        </div>
                    </div>

                </div>



                <!-- ==================== CHAT MESSAGES ==================== -->

                <div id="chat-messages" class="chat-messages-area">

                    <% if (messages && messages.length> 0) { %>


                        <% messages.forEach(message=> { %>

                            <% const isMine=message.sender._id.toString()===currentUser._id.toString(); %>

                                <!-- MESSAGE ROW -->

                                <div class="<%= isMine
                                ? 'message-row mine'
                                : 'message-row theirs'
                            %>">

                                    <!-- MESSAGE BUBBLE -->

                                    <div class="<%= isMine
                                    ? 'message-bubble mine-bubble'
                                    : 'message-bubble their-bubble'
                                %>">

                                        <%= message.text %>


                                            <!-- TIME -->

                                            <div class="message-time">

                                                <%= new Date( message.createdAt ).toLocaleTimeString( [], {
                                                    hour: "2-digit" , minute: "2-digit" } ) %>

                                            </div>

                                    </div>

                                </div>

                                <% }) %>


                                    <% } else { %>


                                        <!-- NO MESSAGES -->

                                        <div class="no-chat-selected">

                                            <div style="text-align: center;">

                                                <i class="uil uil-comment no-convos-icon"></i>

                                                <h3>
                                                    Start the conversation
                                                </h3>

                                                <p>
                                                    Send a message to
                                                    <%= receiver.username %>
                                                </p>

                                            </div>

                                        </div>


                                        <% } %>

                </div>



                <!-- ==================== MESSAGE INPUT ==================== -->

                <div class="chat-input-area">

                    <form action="/messages/<%= receiver._id %>" method="POST" class="chat-form">

                        <input type="text" name="text" placeholder="Type a message..." required autocomplete="off"
                            class="chat-input">

                        <button type="submit" class="chat-send-btn">
                            Send
                        </button>

                    </form>

                </div>

                <% } else { %>


                    <!-- ==================== NO CHAT SELECTED ==================== -->

                    <div class="no-chat-selected">

                        <div style="text-align: center;">

                            <i class="uil uil-message" style="font-size: 70px;"></i>

                            <h2>
                                Your Messages
                            </h2>

                            <p>
                                Select a conversation to start chatting.
                            </p>

                        </div>

                    </div>

                    <% } %>

        </div>

    </div>

    <!-- ==================== AUTO SCROLL ==================== -->

    <script>

        const chatMessages =
            document.getElementById("chat-messages");

        if (chatMessages) {

            chatMessages.scrollTop =
                chatMessages.scrollHeight;

        }

    </script>