<% layout("layouts/boilerplate") -%>

<div class="messages-container <%= receiver ? 'chat-active' : '' %>">

    <!-- =========================
         LEFT SIDEBAR
    ========================== -->

    <div class="messages-sidebar">

        <div class="messages-title">
            Messages
        </div>

        <div class="conversations-list">

            <% if (conversations && conversations.length > 0) { %>

                <% conversations.forEach(conversation => { %>

                    <a
                        href="/messages/<%= conversation.user._id %>"
                        class="conversation-item <%= receiver && receiver._id.toString() === conversation.user._id.toString() ? 'active-conversation' : '' %>"
                    >

                        <!-- Avatar -->
                        <div class="convo-avatar avatar-med">

                            <% if (conversation.user.profilePic) { %>

                                <img
                                    src="<%= conversation.user.profilePic %>"
                                    alt="Profile"
                                    class="convo-img"
                                >

                            <% } else { %>

                                <%= conversation.user.username
                                    .charAt(0)
                                    .toUpperCase()
                                %>

                            <% } %>

                        </div>


                        <!-- Conversation Info -->
                        <div class="convo-info">

                            <strong>
                                <%= conversation.user.username %>
                            </strong>

                            <div class="convo-text">

                                <%= conversation.lastMessage.text %>

                            </div>

                        </div>


                        <!-- Date -->
                        <div class="convo-date">

                            <%= new Date(
                                conversation.lastMessage.createdAt
                            ).toLocaleDateString() %>

                        </div>

                    </a>

                <% }) %>


            <% } else { %>

                <!-- No Conversations -->

                <div class="no-conversations">

                    <i class="uil uil-message no-convos-icon"></i>

                    <h3>
                        No messages yet
                    </h3>

                    <p>
                        Visit someone's profile to start a conversation.
                    </p>

                </div>

            <% } %>

        </div>

    </div>


    <!-- =========================
         CHAT AREA
    ========================== -->

    <div class="chat-container">


        <% if (receiver) { %>


            <!-- =========================
                 CHAT HEADER
            ========================== -->

            <div class="chat-header">


                <!-- Mobile Back -->
                <a
                    href="/messages"
                    class="mobile-back-btn"
                >
                    <i class="uil uil-angle-left"></i>
                </a>


                <!-- Receiver Avatar -->
                <div class="chat-avatar avatar-med">

                    <% if (receiver.profilePic) { %>

                        <img
                            src="<%= receiver.profilePic %>"
                            alt="Profile"
                            class="convo-img"
                        >

                    <% } else { %>

                        <%= receiver.username
                            .charAt(0)
                            .toUpperCase()
                        %>

                    <% } %>

                </div>


                <!-- Receiver Information -->
                <div class="chat-user-info">

                    <strong class="chat-username">

                        <%= receiver.username %>

                    </strong>

                    <div class="chat-fullname">

                        <%= receiver.name || receiver.username %>

                    </div>

                </div>


                <!-- =========================
                     DELETE CHAT
                ========================== -->

                <form
                    action="/messages/delete/<%= receiver._id %>"
                    method="POST"
                    class="delete-chat-form"
                    onsubmit="return confirm('Are you sure you want to delete this entire chat?');"
                >

                    <button
                        type="submit"
                        class="delete-chat-btn"
                        title="Delete chat"
                    >

                        <i class="uil uil-trash-alt"></i>

                    </button>

                </form>

            </div>


            <!-- =========================
                 MESSAGES
            ========================== -->

            <div
                id="chat-messages"
                class="chat-messages-area"
            >

                <% if (messages && messages.length > 0) { %>


                    <% messages.forEach(message => { %>

                        <%
                            const isMine =
                                message.sender._id.toString() ===
                                currentUser._id.toString();
                        %>


                        <div
                            class="<%= isMine ? 'message-row mine' : 'message-row theirs' %>"
                        >


                            <div
                                class="<%= isMine ? 'message-bubble mine-bubble' : 'message-bubble their-bubble' %>"
                            >

                                <div class="message-text">

                                    <%= message.text %>

                                </div>


                                <!-- Message Time -->

                                <div class="message-time">

                                    <%= new Date(
                                        message.createdAt
                                    ).toLocaleTimeString([], {
                                        hour: "2-digit",
                                        minute: "2-digit"
                                    }) %>

                                </div>

                            </div>

                        </div>

                    <% }) %>


                <% } else { %>


                    <!-- No Messages -->

                    <div class="no-chat-selected">

                        <div style="text-align: center;">

                            <i
                                class="uil uil-comment"
                                style="font-size: 60px;"
                            ></i>

                            <h3>
                                Start the conversation
                            </h3>

                            <p>
                                Send a message to
                                <%= receiver.username %>
                            </p>

                        </div>

                    </div>


                <% } %>

            </div>


            <!-- =========================
                 MESSAGE INPUT
            ========================== -->

            <div class="chat-input-area">

                <form
                    action="/messages/<%= receiver._id %>"
                    method="POST"
                    class="chat-form"
                >

                    <input
                        type="text"
                        name="text"
                        class="chat-input"
                        placeholder="Type a message..."
                        autocomplete="off"
                        required
                    >


                    <button
                        type="submit"
                        class="chat-send-btn"
                    >

                        Send

                    </button>

                </form>

            </div>


        <% } else { %>


            <!-- =========================
                 NO CHAT SELECTED
            ========================== -->

            <div class="no-chat-selected">

                <div style="text-align: center;">

                    <i
                        class="uil uil-message"
                        style="font-size: 70px;"
                    ></i>

                    <h2>
                        Your Messages
                    </h2>

                    <p>
                        Select a conversation to start chatting.
                    </p>

                </div>

            </div>


        <% } %>

    </div>

</div>


<!-- =========================
     AUTO SCROLL
========================== -->

<script>

    const chatMessages =
        document.getElementById("chat-messages");

    if (chatMessages) {

        chatMessages.scrollTop =
            chatMessages.scrollHeight;

    }

</script>